# ─────────────────────────────────────────────────────────────────────────────
# BillFlow Backend — Environment Variables
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Settings → Database → Connection String → URI
# Replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.XXXXXXXXXXXX.supabase.co:5432/postgres

# For local development without Supabase (SQLite fallback):
# DATABASE_URL=sqlite:///./billflow.db

# JWT Secret — change this to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=billflow-change-this-secret-key-in-production

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
